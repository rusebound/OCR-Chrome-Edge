{
  "manifest_version": 3,
  "name": "OCR",
  "short_name": "OCR",
  "description": "Türkçe OCR: Chrome ve Edge sitelerinde alan seç, metni çevrimdışı tanı ve panoya kopyala.",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OCR — Ekrandan Türkçe metin seç",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "start-ocr": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Türkçe OCR — sayfada alan seç ve panoya kopyala"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
